<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.apptareas.controllers.MainController">
    <top>
        <ToolBar>
            <Button text="Nueva Tarea" onAction="#addTask" />
            <Button text="Modificar Tarea" onAction="#editTask" />
            <Button text="Estadísticas" onAction="#viewStats" />
        </ToolBar>
    </top>
    <center>
        <ListView fx:id="taskListView" />
    </center>
</BorderPane>
