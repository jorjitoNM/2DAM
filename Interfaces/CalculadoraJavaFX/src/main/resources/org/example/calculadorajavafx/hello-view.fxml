    <!-- Primera fila -->
    <Button mnemonicParsing="false" prefHeight="45" prefWidth="45" style="-fx-background-color: #4992ff" text="\%" GridPane.halignment="CENTER">
      <font>
        <Font name="Arial" size="12.0" />
      </font></Button>
    <Button mnemonicParsing="false" prefHeight="45" prefWidth="45" style="-fx-background-color: #fffa49" text="CE" GridPane.columnIndex="1" GridPane.halignment="CENTER">
      <font>
        <Font name="Arial" size="12.0" />
      </font></Button>
    <Button mnemonicParsing="false" prefHeight="45" prefWidth="45" style="-fx-background-color: #fffa49" text="C" GridPane.columnIndex="2" GridPane.halignment="CENTER">
      <font>
        <Font name="Arial" size="12.0" />
      </font></Button>
    <Button mnemonicParsing="false" prefHeight="45" prefWidth="45" style="-fx-background-color: #fc6c6c" text="⬅" GridPane.columnIndex="3" GridPane.halignment="CENTER">
      <font>
        <Font name="Arial" size="12.0" />
      </font></Button>

    <!-- Segunda fila -->
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="7" GridPane.halignment="CENTER" GridPane.rowIndex="1">
      <font>
        <Font name="Arial" size="12.0" />
      </font></Button>
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="8" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="1">
