        <Font name="Arial" size="12.0" />
      </font></Button>
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="5" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="2">
