        <Font name="Arial" size="12.0" />
      </font></Button>
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="2" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="3">
      <font>
        <Font name="Arial" size="12.0" />
      </font></Button>
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="3" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="3">
      <font>
        <Font name="Arial" size="12.0" />
      </font></Button>
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" style="-fx-background-color: #4992ff" text="+" GridPane.columnIndex="3" GridPane.halignment="CENTER" GridPane.rowIndex="3">
      <font>
        <Font name="Arial" size="15.0" />
      </font></Button>

    <!-- Quinta fila -->
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="0" GridPane.halignment="CENTER" GridPane.rowIndex="4">
      <font>
        <Font name="Arial" size="12.0" />
      </font></Button>
    <Button mnemonicParsing="false" prefHeight="45" prefWidth="45" style="-fx-background-color: #fffa49" text="." GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="4">
      <font>
        <Font name="Arial" size="20.0" />
      </font></Button>
    <Button mnemonicParsing="false" onAction="#onEqualClicked" prefHeight="45" prefWidth="45" style="-fx-background-color: #53ff75" text="=" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="4">
         <font>
            <Font name="Arial Bold" size="12.0" />
         </font></Button>
    <Button mnemonicParsing="false" prefHeight="45" prefWidth="45" style="-fx-background-color: #4992ff" text="/" GridPane.columnIndex="3" GridPane.halignment="CENTER" GridPane.rowIndex="4">
      <font>
        <Font name="Arial" size="15.0" />
      </font></Button>
