        <Font name="Arial" size="12.0" />
      </font></Button>
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="9" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="1">
      <font>
        <Font name="Arial" size="12.0" />
      </font></Button>
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" style="-fx-background-color: #4992ff" text="x" GridPane.columnIndex="3" GridPane.halignment="CENTER" GridPane.rowIndex="1">
      <font>
        <Font name="Arial" size="15.0" />
      </font></Button>

    <!-- Tercera fila -->
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="4" GridPane.halignment="CENTER" GridPane.rowIndex="2">
