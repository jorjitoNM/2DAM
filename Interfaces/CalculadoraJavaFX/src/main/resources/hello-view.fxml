<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="640.0" prefWidth="360.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.calculadorajavafx.HelloController">

  <TextField fx:id="caja" layoutX="80.0" layoutY="86.0" prefHeight="74.0" prefWidth="199.0" />

  <GridPane alignment="center" layoutX="39.0" layoutY="215.0">
    <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="70.0" />
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="70.0" />
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="70.0" />
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="70.0" />
    </columnConstraints>
    <rowConstraints>
      <RowConstraints minHeight="10.0" prefHeight="70" vgrow="SOMETIMES" />
      <RowConstraints minHeight="10.0" prefHeight="70" vgrow="SOMETIMES" />
      <RowConstraints minHeight="10.0" prefHeight="70.0" vgrow="SOMETIMES" />
      <RowConstraints minHeight="10.0" prefHeight="70.0" vgrow="SOMETIMES" />
      <RowConstraints minHeight="10.0" prefHeight="70.0" vgrow="SOMETIMES" />
    </rowConstraints>

    <!-- Primera fila -->
    <Button mnemonicParsing="false" prefHeight="45" prefWidth="45" text="\%" GridPane.halignment="CENTER" />
    <Button mnemonicParsing="false" prefHeight="45" prefWidth="45" text="CE" GridPane.columnIndex="1" GridPane.halignment="CENTER" />
    <Button mnemonicParsing="false" prefHeight="45" prefWidth="45" text="C" GridPane.columnIndex="2" GridPane.halignment="CENTER" />
    <Button mnemonicParsing="false" prefHeight="45" prefWidth="45" text="⬅" GridPane.columnIndex="3" GridPane.halignment="CENTER" />

    <!-- Segunda fila -->
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="7" GridPane.halignment="CENTER" GridPane.rowIndex="1" />
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="8" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="1" />
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="9" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="1" />
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="×" GridPane.columnIndex="3" GridPane.halignment="CENTER" GridPane.rowIndex="1" />

    <!-- Tercera fila -->
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="4" GridPane.halignment="CENTER" GridPane.rowIndex="2" />
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="5" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="2" />
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="6" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="2" />
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="-" GridPane.columnIndex="3" GridPane.halignment="CENTER" GridPane.rowIndex="2" />

    <!-- Cuarta fila -->
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="1" GridPane.halignment="CENTER" GridPane.rowIndex="3" />
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="2" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="3" />
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="3" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="3" />
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="+" GridPane.columnIndex="3" GridPane.halignment="CENTER" GridPane.rowIndex="3" />

    <!-- Quinta fila -->
    <Button mnemonicParsing="false" onAction="#onNumberClicked" prefHeight="45" prefWidth="45" text="0" GridPane.halignment="CENTER" GridPane.rowIndex="4" />
    <Button mnemonicParsing="false" prefHeight="45" prefWidth="45" text="." GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="4" />
    <Button mnemonicParsing="false" prefHeight="45" prefWidth="45" text="=" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="4" onAction="#onEqualClicked" />
    <Button mnemonicParsing="false" prefHeight="45" prefWidth="45" text="/" GridPane.columnIndex="3" GridPane.halignment="CENTER" GridPane.rowIndex="4" />
  </GridPane>
</AnchorPane>
